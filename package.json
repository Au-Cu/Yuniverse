{
  "name": "yuniverse-desktop-pet",
  "version": "1.0.0",
  "description": "JUST大猫、JUST外星猫与珉鸟组成的柳智敏衍生桌宠小宇宙",
  "main": "src/main.js",
  "author": "Yuniverse",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:minbird-assets": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-minbird-assets.ps1",
    "patch:builder": "node tools/patch-electron-builder.js",
    "verify:assets": "electron tools/verify-assets.js",
    "make:icon": "electron tools/make-icon.js",
    "prebuild": "npm run patch:builder && npm run test && npm run verify:assets && npm run make:icon",
    "build": "electron-builder --win portable",
    "predist": "npm run patch:builder && npm run test && npm run verify:assets && npm run make:icon",
    "dist": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.justcats.desktop.pet",
    "productName": "Yuniverse",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/source/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "Yuniverse",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "Yuniverse-Portable-${version}.${ext}",
      "useZip": true,
      "warningsAsErrors": false
    },
    "nsis": {
      "artifactName": "Yuniverse-Setup-${version}.${ext}",
      "useZip": true,
      "warningsAsErrors": false,
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yuniverse",
      "uninstallDisplayName": "Yuniverse"
    }
  }
}
